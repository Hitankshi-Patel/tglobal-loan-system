# Backend Server Port
PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Connection String (Session / Transaction Pooler with pgbouncer=true)
DATABASE_URL="postgresql://postgres.USER:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection String (Used for Prisma migrations on port 5432)
DIRECT_URL="postgresql://postgres:PASSWORD@db.USER.supabase.co:5432/postgres"

# Gold rate per gram in Rupees for 24K pure gold
RATE_24K_PER_GRAM=7000

# Frontend Origin for CORS (e.g. http://your-domain.com or http://vps-ip)
FRONTEND_URL="http://localhost:5173"

# ─── AI Agent Configuration ───────────────────────────────────────────────────
# Option 1: Google Gemini (Primary - Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=""

# Option 2: Ollama (Local fallback — used when GEMINI_API_KEY is empty)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# ─── Admin Authentication ─────────────────────────────────────────────────────
# Admin credentials (CHANGE THESE BEFORE DEPLOYING TO PRODUCTION!)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_me_to_a_strong_password"

# JWT secret for signing admin tokens (Generate with: openssl rand -base64 32)
JWT_SECRET="generate_a_secure_random_jwt_secret_key_here"
